      "text": "Refund Service",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "-R3j4WlZJZsGWF6GUP1X2",
      "originalText": "Refund Service",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "93fdBRMXrgIQ4ctzp3maZ",
      "type": "text",
      "x": 1668.9796022691005,
      "y": 11795.686913332676,
      "width": 896.9793090820312,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2Y",
      "roundness": null,
      "seed": 571872852,
      "version": 857,
      "versionNonce": 290003564,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786552021869,
      "link": null,
      "locked": false,
      "text": "Problem Statement:\nWe need a conversational agent that can:\n    1. Answer Netflix-specific and account-specific questions.\n    2. Retrieve information from Netflix policies/SOPs.\n    3. Process refunds automatically up to a configured threshold.\n    4. Escalate refunds above the threshold to a human.\n    5. Create support tickets when human review is required.\n    6. Immediately transfer to a human when the customer explicitly asks for one.\n    7. Maintain conversation context.\n    8. Audit every decision and action.\n    9. Prevent the LLM from bypassing Netflix policies.\n\nSolution:\nFor Netflix specific queries - RAG for SOPs, policies\nFor User specific queries - User account/telemetry  Data\nFor Refund specific queries - User's account/transaction Data\nRefunds are transactional process involving money - Refunds should be strictly policy driven\nFor Human escalation -  Human handoff service\nFor connecting with services - Tools Gateway\nNow user query can be transactional/FAQ/User Specific/Refund\nTo Prevent LLM bypass policies - Policy Engine - Determines/Allow/Deny LLM's request.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Problem Statement:\nWe need a conversational agent that can:\n    1. Answer Netflix-specific and account-specific questions.\n    2. Retrieve information from Netflix policies/SOPs.\n    3. Process refunds automatically up to a configured threshold.\n    4. Escalate refunds above the threshold to a human.\n    5. Create support tickets when human review is required.\n    6. Immediately transfer to a human when the customer explicitly asks for one.\n    7. Maintain conversation context.\n    8. Audit every decision and action.\n    9. Prevent the LLM from bypassing Netflix policies.\n\nSolution:\nFor Netflix specific queries - RAG for SOPs, policies\nFor User specific queries - User account/telemetry  Data\nFor Refund specific queries - User's account/transaction Data\nRefunds are transactional process involving money - Refunds should be strictly policy driven\nFor Human escalation -  Human handoff service\nFor connecting with services - Tools Gateway\nNow user query can be transactional/FAQ/User Specific/Refund\nTo Prevent LLM bypass policies - Policy Engine - Determines/Allow/Deny LLM's request.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
