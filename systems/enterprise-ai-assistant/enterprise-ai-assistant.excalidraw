    {
      "id": "zmwLjt4POWAPhGfDnuOsr",
      "type": "text",
      "x": 150.3576678395156,
      "y": 1308.8544153477872,
      "width": 1296.2393798828125,
      "height": 725,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aj",
      "roundness": null,
      "seed": 1062105352,
      "version": 1510,
      "versionNonce": 297460232,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785814897330,
      "link": null,
      "locked": false,
      "text": "APIS:\nUsers:\n1. Signup-> Post /api/signup \n    Req Body: { \"username\": <username>, password: \"secure_password\"}\n    Response : 201 created {\"message\" : \"User created successfully\"}\n\n2. Login -> Post /api/login\n    Req Body: { \"username\": <username>, password: \"secure_password\"}\n    Response : 200 Ok {\"message\" : \"Login Succssful\"}\n\nAuctions:\n1. Create Auction: -> Post /api/auctions\n    Req Body: {\"item_name\" : \"<item_name>\", \"item_base_price\" : \"<base_price>\", \"start_time\": <start_time>, \"duration\" : \"<duration>\"}\n    Response: 201 created {\"message\" : \"auction created\", \"id\": <auction_id>}\n2. View Auction -> Get /api/auctions/{id}\n3. Place Bid -> Post /api/auctions/{id}/bids\n4. History Bid -> Get /api/auctions/{id}/bids\n5. View Active Auctions - Get /api/auctions/active \n\nPayments:\n1. make Payment -> Post /api/payments/initiate \n2. check status -> Get /api/payments/{id}/status\n\nNotifications:\n1. Auction Ending -> Notify Winner\n2. Payment Succesful -> Notify Payee\n3. New highest bid -> Notify previous top bidder\n \n            ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "APIS:\nUsers:\n1. Signup-> Post /api/signup \n    Req Body: { \"username\": <username>, password: \"secure_password\"}\n    Response : 201 created {\"message\" : \"User created successfully\"}\n\n2. Login -> Post /api/login\n    Req Body: { \"username\": <username>, password: \"secure_password\"}\n    Response : 200 Ok {\"message\" : \"Login Succssful\"}\n\nAuctions:\n1. Create Auction: -> Post /api/auctions\n    Req Body: {\"item_name\" : \"<item_name>\", \"item_base_price\" : \"<base_price>\", \"start_time\": <start_time>, \"duration\" : \"<duration>\"}\n    Response: 201 created {\"message\" : \"auction created\", \"id\": <auction_id>}\n2. View Auction -> Get /api/auctions/{id}\n3. Place Bid -> Post /api/auctions/{id}/bids\n4. History Bid -> Get /api/auctions/{id}/bids\n5. View Active Auctions - Get /api/auctions/active \n\nPayments:\n1. make Payment -> Post /api/payments/initiate \n2. check status -> Get /api/payments/{id}/status\n\nNotifications:\n1. Auction Ending -> Notify Winner\n2. Payment Succesful -> Notify Payee\n3. New highest bid -> Notify previous top bidder\n \n            ",
      "autoResize": true,
      "lineHeight": 1.25
    },
